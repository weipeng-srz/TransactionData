{
  "name": "trendsight-market-workbench",
  "version": "0.1.0",
  "description": "TrendSight A-share market research workbench",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weipeng-srz/TransactionData.git",
    "directory": "web"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "postcss": "8.5.10"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm run db:migrate:local && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "pnpm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "backtest:main-force-intent": "node --experimental-strip-types scripts/backtest-main-force-intent.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node scripts/migrate-local-d1.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "liquid-glass-react": "1.1.1",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.3.2",
    "wrangler": "4.147.0"
  },
  "type": "module"
}
